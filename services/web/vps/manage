#!/bin/sh
set -eu
directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository=$(CDPATH= cd -- "$directory/../../.." && pwd)
action=${1:-}
run_model_smoke() {
  docker run --rm --pull never --network none \
    --read-only --cap-drop ALL --security-opt no-new-privileges \
    --memory 1536m --memory-swap 1536m --cpus 1 --pids-limit 128 \
    --tmpfs /tmp:size=64M,noexec,nosuid \
    --env PRIZMA_EXPECT_LANGUAGES=en,ru \
    --mount "type=bind,src=$repository/services/analyzer/vps/smoke.mjs,dst=/app/vps-smoke.mjs,readonly" \
    --entrypoint node "$1" /app/vps-smoke.mjs
}
case "$action" in
  build)
    model_image=prizma-analyzer:local
    if docker image inspect prizma-models:multilingual >/dev/null 2>&1; then
      model_image=prizma-models:multilingual
    fi
    exec docker build --network none --build-arg "MODEL_IMAGE=$model_image" --file "$repository/services/web/Dockerfile" --tag prizma-selfhost:local "$repository"
    ;;
  build-multilingual)
    # No service restart: retain the installed image tags unless offline inference succeeds.
    docker build --file "$repository/services/analyzer/Dockerfile.multilingual" --tag prizma-models:multilingual-candidate "$repository"
    docker build --network none --build-arg MODEL_IMAGE=prizma-models:multilingual-candidate \
      --file "$repository/services/web/Dockerfile" --tag prizma-selfhost:multilingual-candidate "$repository"
    run_model_smoke prizma-selfhost:multilingual-candidate
    docker tag prizma-models:multilingual-candidate prizma-models:multilingual
    docker tag prizma-selfhost:multilingual-candidate prizma-selfhost:local
    echo MULTILINGUAL_BUILD_OK
    ;;
  model-smoke)
    run_model_smoke prizma-selfhost:local
    ;;
  configure)
    [ "$#" -eq 2 ] || { echo 'HTTPS origin required' >&2; exit 2; }
    gateway=$(docker network inspect --format '{{(index .IPAM.Config 0).Gateway}}' prizma_default)
    exec docker run --rm --pull never --network none --user 0:0 \
      --read-only --cap-drop ALL --cap-add CHOWN --security-opt no-new-privileges \
      --memory 128m --memory-swap 128m --pids-limit 32 \
      --mount "type=bind,src=$directory,dst=/setup" \
      --entrypoint node prizma-analyzer:local /setup/setup.mjs "$2" "$gateway"
    ;;
  start)
    [ -f "$directory/.private/web.env" ] || { echo 'Configure the HTTPS origin first' >&2; exit 2; }
    exec docker compose --project-name prizma --file "$directory/compose.yaml" up -d --no-build --pull never web analyzer
    ;;
  health)
    exec docker compose --project-name prizma --file "$directory/compose.yaml" exec -T web node --input-type=module -e \
      'for(const [name,url] of [["web","http://127.0.0.1:8081/healthz"],["analyzer","http://analyzer:8080/healthz"]]){try{const r=await fetch(url,{signal:AbortSignal.timeout(5000)});console.log(name+" "+r.status+" "+await r.text());if(!r.ok)process.exitCode=1}catch{console.log(name+" unavailable");process.exitCode=1}}'
    ;;
  proxy-install)
    exec python3 "$directory/proxy.py"
    ;;
  antivirus-probe)
    exec python3 "$directory/antivirus_probe.py"
    ;;
  logs)
    exec docker compose --project-name prizma --file "$directory/compose.yaml" logs --tail 30 web analyzer
    ;;
  stop)
    exec docker compose --project-name prizma --file "$directory/compose.yaml" stop web analyzer
    ;;
  *) echo 'Usage: manage build | build-multilingual | model-smoke | configure <https-origin> | start | health | proxy-install | antivirus-probe | logs | stop' >&2; exit 2 ;;
esac
